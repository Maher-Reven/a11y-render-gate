{
  "name": "a11y-render-gate",
  "version": "0.3.0",
  "description": "An accessibility gate inside the agent loop. Renders the UI an agent just wrote and reports contrast, focus visibility, hit targets and label wiring as computed facts with fix-shaped payloads.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "a11y-render-gate": "./dist/cli/index.js",
    "a11y-render-gate-mcp": "./dist/mcp/server.js",
    "a11y-render-gate-hook": "./dist/hook/stop-gate.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "mcp",
    "claude-code",
    "agent",
    "contrast",
    "playwright"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axe-core": "^4.13.0",
    "commander": "^12.1.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maher-Reven/a11y-render-gate.git"
  },
  "bugs": {
    "url": "https://github.com/Maher-Reven/a11y-render-gate/issues"
  },
  "homepage": "https://github.com/Maher-Reven/a11y-render-gate#readme"
}
